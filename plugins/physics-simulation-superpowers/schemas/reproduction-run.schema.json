{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reproduction-run.schema.json",
  "title": "Reproduction Run",
  "type": "object",
  "required": [
    "schema_version",
    "target",
    "reproduction_mode",
    "artifact",
    "inventory_hashes",
    "environment",
    "commands",
    "inputs",
    "expected_results",
    "observed_results",
    "tolerances",
    "patch_log",
    "deviations",
    "evidence_paths",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "target": {
      "type": "object",
      "required": ["claim_id", "source_anchor", "category", "description"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source_anchor": {
          "type": "object",
          "required": ["kind", "locator"],
          "properties": {
            "kind": {"enum": ["figure", "table", "equation", "section", "algorithm", "appendix", "supplement", "page", "abstract"]},
            "locator": {"type": "string", "minLength": 1, "pattern": "\\S"}
          },
          "additionalProperties": false
        },
        "category": {"enum": ["reported-numeric-result", "reported-performance-result", "reported-figure-result"]},
        "description": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    },
    "reproduction_mode": {"enum": ["artifact-rerun", "independent-reimplementation"]},
    "artifact": {
      "type": "object",
      "required": ["name", "commit"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "commit": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    },
    "inventory_hashes": {"type": "object", "minProperties": 1},
    "environment": {"type": "object", "minProperties": 1},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "inputs": {"type": "object", "minProperties": 1},
    "expected_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "result_type", "metric", "expected"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "result_type": {"enum": ["numeric-measurement", "performance-comparison", "qualitative-behavior", "figure-comparison"]},
          "metric": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "expected": {"anyOf": [{"type": "number"}, {"type": "string", "minLength": 1, "pattern": "\\S"}]},
          "unit": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "allOf": [
          {
            "if": {"properties": {"result_type": {"enum": ["numeric-measurement", "performance-comparison"]}}, "required": ["result_type"]},
            "then": {"properties": {"expected": {"type": "number"}}}
          },
          {
            "if": {"properties": {"result_type": {"enum": ["qualitative-behavior", "figure-comparison"]}}, "required": ["result_type"]},
            "then": {"properties": {"expected": {"type": "string", "minLength": 1, "pattern": "\\S"}}}
          }
        ],
        "additionalProperties": false
      }
    },
    "observed_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "result_type", "metric", "observed", "outcome", "evidence_path"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "result_type": {"enum": ["numeric-measurement", "performance-comparison", "qualitative-behavior", "figure-comparison"]},
          "metric": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "observed": {"anyOf": [{"type": "number"}, {"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "null"}]},
          "outcome": {"enum": ["exact-match", "within-tolerance", "qualitative-match", "mismatch", "not-evaluated"]},
          "evidence_path": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "unit": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "allOf": [
          {
            "if": {"properties": {"outcome": {"const": "not-evaluated"}}, "required": ["outcome"]},
            "then": {"properties": {"observed": {"type": "null"}}},
            "else": {
              "allOf": [
                {
                  "if": {"properties": {"result_type": {"enum": ["numeric-measurement", "performance-comparison"]}}, "required": ["result_type"]},
                  "then": {"properties": {"observed": {"type": "number"}}}
                },
                {
                  "if": {"properties": {"result_type": {"enum": ["qualitative-behavior", "figure-comparison"]}}, "required": ["result_type"]},
                  "then": {"properties": {"observed": {"type": "string", "minLength": 1, "pattern": "\\S"}}}
                }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "tolerances": {"type": "object", "minProperties": 1},
    "patch_log": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "deviations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "status": {"enum": ["pass", "partial", "fail", "blocked"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observed_results": {
            "contains": {"type": "object", "properties": {"outcome": {"const": "not-evaluated"}}, "required": ["outcome"]}
          }
        },
        "required": ["observed_results"]
      },
      "then": {"properties": {"status": {"enum": ["blocked", "fail"]}}}
    },
    {
      "if": {"properties": {"status": {"const": "partial"}}, "required": ["status"]},
      "then": {
        "properties": {
          "observed_results": {
            "contains": {
              "type": "object",
              "properties": {"outcome": {"enum": ["exact-match", "within-tolerance", "qualitative-match", "mismatch"]}},
              "required": ["outcome"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
      "then": {
        "properties": {
          "observed_results": {
            "items": {
              "type": "object",
              "properties": {"outcome": {"const": "not-evaluated"}},
              "required": ["outcome"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "fail"}}, "required": ["status"]},
      "then": {
        "properties": {
          "observed_results": {
            "contains": {
              "type": "object",
              "properties": {"outcome": {"enum": ["mismatch", "not-evaluated"]}},
              "required": ["outcome"]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
