{
  "name": "project-design-keeper",
  "version": "1.0.1",
  "description": "Distill local project evidence into validated design documentation and reusable project context.",
  "private": true,
  "type": "module",
  "author": {
    "name": "EverfIRE",
    "url": "https://github.com/EverfIRE"
  },
  "homepage": "https://github.com/EverfIRE/ProjectDesignKeeper#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/EverfIRE/ProjectDesignKeeper.git",
    "directory": "source"
  },
  "bugs": {
    "url": "https://github.com/EverfIRE/ProjectDesignKeeper/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1 --testTimeout=120000",
    "test:task10-local": "npm run test:ci && vitest run --config vitest.task10-local.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --testTimeout=120000",
    "test:perf": "npm run build && node test/performance.mjs --scenario full",
    "benchmark:prepare": "node scripts/create-benchmark-fixture.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js && esbuild src/plugin.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/plugin.js --external:@deepseek-ai/*",
    "smoke": "npm run build && node test/smoke.mjs",
    "package": "npm run build && node scripts/package-plugin.mjs",
    "package:verify": "npm run package && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../../DSHarness/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "file:../../DSHarness/deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-llm": "file:../../DSHarness/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-system-prompt": "file:../../DSHarness/deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "file:../../DSHarness/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-user-approval": "file:../../DSHarness/deepseek-harness/packages/interaction/user-approval",
    "@deepseek-ai/dsh-user-questions": "file:../../DSHarness/deepseek-harness/packages/interaction/user-questions",
    "@deepseek-ai/schemastery": "file:../../DSHarness/deepseek-harness/vendor/schemastery",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
